# Copia este archivo como .env.local y llena los valores.
# Sin las dos primeras variables la app NO arranca (responde 503): Supabase es obligatorio.
# Solo para desarrollar sin red: ALLOW_LOCAL_MODE=1 con `npm run dev` (sesiones simuladas; nunca en producción).

# Supabase → Project Settings → API (o "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SOLO en la computadora de quien carga los datos (`npm run seed:demo`). NUNCA en Vercel ni en GitHub.
SUPABASE_SERVICE_ROLE_KEY=
# Contraseña de las cuentas demo. Genérala con `npm run demo:password` (no la escribas a mano aquí).
DEMO_PASSWORD=

# Desarrollo sin Supabase (solo `npm run dev`): ALLOW_LOCAL_MODE=1
ALLOW_LOCAL_MODE=

# Muestra en /login los CORREOS de las cuentas de demostración (útil en el hackatón). Quítalo en producción.
SHOW_DEMO_ACCOUNTS=1

# Opcional: sube el límite de la API de GitHub de 60 a 5,000 consultas por hora.
GITHUB_TOKEN=
